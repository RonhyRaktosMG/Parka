@model IEnumerable<ParkaApp.Models.Area>

@{
    ViewData["Title"] = "Parking Areas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-0">Parking Areas</h1>
        <p class="text-muted mb-0">Manage all your parking areas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>Create New Area
    </a>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <strong>No areas found.</strong> Create your first parking area to get started.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else
{
    <div class="row">
        @foreach (var area in Model)
        {
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-gradient text-white border-0">
                        <h5 class="mb-0">
                            <i class="bi bi-map-fill me-2"></i>@area.Name
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <strong>Address:</strong>
                            <p class="text-muted mb-0">@area.Address</p>
                        </div>
                        <div class="mb-3">
                            <strong>Coordinates:</strong>
                            <p class="text-muted mb-0">Lat: @area.Latitude.ToString("F4"), Lon: @area.Longitude.ToString("F4")</p>
                        </div>
                        <div>
                            <strong>Total Places:</strong>
                            <p class="text-muted mb-0">@area.Places.Count places</p>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-0 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@area.Id" class="btn btn-sm btn-info flex-grow-1">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        <a asp-action="Edit" asp-route-id="@area.Id" class="btn btn-sm btn-primary flex-grow-1">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@area.Id" class="btn btn-sm btn-danger flex-grow-1">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
