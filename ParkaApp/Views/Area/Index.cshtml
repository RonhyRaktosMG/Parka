@model IEnumerable<ParkaApp.Models.Area>

@{
    ViewData["Title"] = "Parking Areas";
}

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-4xl font-bold text-white">Parking Areas</h1>
            <p class="mt-2 text-lg text-gray-300">Manage all your parking areas on the map</p>
        </div>
        <a asp-action="Create"
           class="inline-flex items-center gap-3 rounded-2xl bg-(--color-primary) px-6 py-3.5 font-semibold text-white transition-all hover:bg-(--color-primary-dark) hover:shadow-lg">
            <i class="bi bi-plus-circle text-xl"></i>
            Create Area
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Map - Left Side (smaller) -->
        <div class="lg:col-span-7 bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div id="map" class="h-130 w-full"></div>
        </div>

        <!-- Areas List - Right Side -->
        <div class="lg:col-span-5 bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 text-white">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <i class="bi bi-list-ul"></i>
                All Areas
            </h2>

            @if (!Model.Any())
            {
                <div class="text-center py-12 text-gray-400">
                    <i class="bi bi-map text-5xl mb-3"></i>
                    <p>No parking areas yet</p>
                </div>
            }
            else
            {
                <div class="space-y-3 max-h-120 overflow-auto pr-2 custom-scroll">
                    @foreach (var area in Model)
                    {
                        <div class="group bg-[#2d2925]/50 hover:bg-white/10 border border-white/10 rounded-2xl p-4 transition-all">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-bold text-lg text-white">@area.Name</h3>
                                    <p class="text-sm text-gray-300 line-clamp-2">@area.Address</p>
                                </div>
                            </div>
                            
                            <div class="flex gap-2">
                                <a asp-action="Details" asp-route-id="@area.Id"
                                   class="flex-1 text-center py-2.5 text-sm font-medium bg-blue-500/30 hover:bg-blue-500/40 text-white rounded-xl transition">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@area.Id"
                                   class="flex-1 text-center py-2.5 text-sm font-medium bg-amber-500/30 hover:bg-amber-500/40 text-white rounded-xl transition">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@area.Id"
                                   class="flex-1 text-center py-2.5 text-sm font-medium bg-red-500/20 hover:bg-red-500/30 text-white rounded-xl transition">
                                    Delete
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const map = L.map('map').setView([-18.8792, 47.5079], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        @foreach (var area in Model)
        {
            <text>
                var lat = @area.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lng = @area.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);

                var marker = L.marker([lat, lng]).addTo(map);

                marker.bindPopup(`
                    <div style="min-width: 260px;">
                        <h3 style="margin:0 0 6px 0; font-size:17px; font-weight:600;">@area.Name</h3>
                        <p style="margin:0; color:#888; font-size:14px;">@area.Address</p>
                        <div style="margin-top:12px; display:flex; gap:6px;">
                            <a href="@Url.Action("Details", "Area", new { id = area.Id })" class="flex-1 text-center py-2 text-xs font-medium bg-sky-600 text-white rounded-xl">View</a>
                            <a href="@Url.Action("Edit", "Area", new { id = area.Id })" class="flex-1 text-center py-2 text-xs font-medium bg-indigo-600 text-white rounded-xl">Edit</a>
                            <a href="@Url.Action("Delete", "Area", new { id = area.Id })" class="flex-1 text-center py-2 text-xs font-medium bg-red-600 text-white rounded-xl">Delete</a>
                        </div>
                    </div>
                `, { maxWidth: 340 });
            </text>
        }
    });
</script>

<style>
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 20px;
    }
</style>