@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Modifier Zone";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Modifier une Zone</span>
        <span class="c1">Mettez à jour les informations de la zone de stationnement</span>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Name -->
            <div class="input-group">
                <label asp-for="Name" class="label">
                    <i class="bi bi-tag me-2"></i>Nom de la Zone
                </label>

                <input asp-for="Name"
                       class="input"
                       placeholder="Ex: Parking Centre-Ville" />

                <span asp-validation-for="Name" class="error-msg"></span>
            </div>

            <!-- Address -->
            <div class="input-group">
                <label asp-for="Address" class="label">
                    <i class="bi bi-house-door me-2"></i>Adresse
                </label>

                <input asp-for="Address"
                       class="input"
                       placeholder="Ex: 123 Avenue de l'Indépendance" />

                <span asp-validation-for="Address" class="error-msg"></span>
            </div>

            <!-- Coordinates -->
            <div class="grid grid-cols-2 gap-6">
                <div class="input-group">
                    <label asp-for="Latitude" class="label">
                        <i class="bi bi-geo-alt me-2"></i>Latitude
                    </label>
                    <input asp-for="Latitude"
                        class="input font-mono"
                        placeholder="-18.8792" />
                    <span asp-validation-for="Latitude" class="error-msg"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Longitude" class="label">
                        <i class="bi bi-geo-alt me-2"></i>Longitude
                    </label>
                    <input asp-for="Longitude"
                        class="input font-mono"
                        placeholder="47.5079" />
                    <span asp-validation-for="Longitude" class="error-msg"></span>
                </div>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Mettre à jour
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>