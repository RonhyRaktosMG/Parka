@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Détails de la Zone";
}

<div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text--(--color-primary)">
                <i class="bi bi-map-fill text-3xl"></i>
            </div>
            <div>
                <h1 class="text-4xl font-semibold text-white">@Model.Name</h1>
                <p class="text-white">Adresse : @Model.Address</p>
            </div>
        </div>

        <div class="flex gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-(--color-primary) text-white rounded-2xl hover:bg-(--color-primary-dark) transition font-medium">
                <i class="bi bi-pencil"></i>
                Modifier la Zone
            </a>
            <a asp-action="Index" 
               class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-(--color-secondary) rounded-2xl hover:bg-gray-50 transition font-medium">
                <i class="bi bi-arrow-left"></i>
                Retour à la liste
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Area Information -->
        <div class=" bg-[var(--color-secondary)] backdrop-blur-md border border-white/20 rounded-3xl p-8 text-white">           
            <div class="grid grid-cols-3 gap-4 pt-4 text-sm">
                <div>
                    <p class="text-xs font-medium text-white/50">ID</p>
                    <p class="text-white/80">@Model.Id</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-white/50">Latitude</p>
                    <p class="font-mono text-white/80">@Model.Latitude.ToString("F6")</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-white/50">Longitude</p>
                    <p class="font-mono text-white/80">@Model.Longitude.ToString("F6")</p>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="lg:col-span-2 flex flex-row justify-center items-center gap-12 bg-[var(--color-secondary)] backdrop-blur-md border border-white/20 rounded-3xl p-8 text-white">
                <div>
                    <p class="text-sm font-medium text-white/50">Places totales</p>
                    <p class="text-lg font-medium text-white text-center">@Model.Places.Count</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-white/50">Places occupées</p>
                    <p class="text-lg font-medium text-white text-center">@Model.Places.Count(p => p.Status == PlaceStatus.Occupied)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-white/50">Places disponibles</p>
                    <p class="text-lg font-medium text-white text-center">@Model.Places.Count(p => p.Status == PlaceStatus.Available)</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-white/50">Places réservées</p>
                    <p class="text-lg font-medium text-white text-center">@Model.Places.Count(p => p.Status == PlaceStatus.Reserved)</p>
                </div>
        </div>
    </div>

    <!-- Parking Places Section -->
    <div class="mt-16 rounded-4xl overflow-hidden">
        <div class="backdrop-blur-md flex justify-between items-center border-b border-white/10 px-8 py-6 bg-[var(--color-secondary-light)]">
            <h2 class="text-xl font-semibold text-white flex items-center gap-3">
                <i class="bi bi-p-circle-fill text-blue-300"></i>
                Places de parking (@Model.Places.Count)
            </h2>
            
            <a asp-action="Create" asp-controller="Place" asp-route-areaId="@Model.Id"
            class="inline-flex items-center gap-2 px-6 py-3 bg-(--color-primary) text-white rounded-2xl hover:bg-(--color-primary-dark) transition font-medium">
                <i class="bi bi-plus-circle"></i>
                Ajouter une Place
            </a>
        </div>

        <div class="p-8">
            @if (!Model.Places.Any())
            {
                <div class="text-center py-16 text-white/50">
                    <i class="bi bi-map text-6xl text-white/20"></i>
                    <p class="mt-4 text-white/70">Aucune place de parking dans cette zone pour le moment.</p>
                    <a asp-action="Create" asp-controller="Place" asp-route-areaId="@Model.Id"
                    class="mt-6 inline-block px-6 py-3 bg-(--color-primary) text-white rounded-2xl hover:bg-(--color-primary-dark)">
                        Créer la première place
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-5 2xl:grid-cols-5 gap-8 justify-items-center items-center">
                    @for (int i = 0; i < Model.Places.Count; i++)
                    {
                        var place = Model.Places[i];
                        var statusInfo = place.Status switch
                        {
                            PlaceStatus.Available => new { Color = "emerald", Bg = "emerald-500/20", Text = "emerald-300" },
                            PlaceStatus.Occupied  => new { Color = "red", Bg = "red-500/20", Text = "red-300" },
                            PlaceStatus.Reserved  => new { Color = "amber", Bg = "amber-500/20", Text = "amber-300" },
                            _ => new { Color = "gray", Bg = "gray-500/20", Text = "gray-300" }
                        };
                        
                        <!-- Single Place Card -->
                        <div class="group relative h-95 w-65 overflow-hidden rounded shadow-lg shrink-0">
                            
                            <!-- Background Image -->
                            <img src="~/images/place.png" 
                                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-103" 
                                alt="@place.Code" />
                            
                            <!-- Dark Overlay -->
                            @* <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-black/20"></div> *@

                            <!-- Content -->
                            <div class="relative flex h-full flex-col justify-between p-5 text-white">
                                
                                <!-- Top -->
                                <div class="flex  flex-col items-center justify-between">
                                    <!-- Code -->
                                    <div class="rounded-2xl  px-4 py-2 text-6xl font-bold ">
                                        @place.Code
                                    </div>
                                    
                                    <!-- Status -->
                                    <div class="rounded-2xl bg-@statusInfo.Bg px-4 py-2 text-xs font-semibold backdrop-blur-md text-@statusInfo.Text">
                                        @switch(place.Status)
                                        {
                                            case PlaceStatus.Available:
                                                @:Disponible
                                                break;
                                            case PlaceStatus.Occupied:
                                                @:Occupée
                                                break;
                                            case PlaceStatus.Reserved:
                                                @:Réservée
                                                break;
                                            default:
                                                @:Inconnu
                                                break;
                                        }
                                    </div>
                                </div>

                                <!-- Center Assign Button (visible on hover) -->
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <a asp-action="AssignPlace" asp-controller="Occupation" asp-route-placeId="@place.Id"
                                    class="flex scale-0 items-center gap-2 rounded-full bg-[var(--color-secondary)] px-6 py-3 text-sm font-semibold backdrop-blur-xl transition duration-300 group-hover:scale-100 hover:bg-[var(--color-secondary-light)]">
                                        <i class="bi bi-person-plus text-lg"></i>
                                    </a>
                                </div>

                                <!-- Bottom Actions -->
                                <div class="flex items-center justify-between">
                                    <a asp-action="Edit" asp-controller="Place" asp-route-id="@place.Id"
                                    class="flex items-center gap-2 rounded-2xl bg-blue-500/20 px-4 py-2.5 text-sm font-medium backdrop-blur-md transition hover:bg-blue-500/40">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                    <a asp-action="Delete" asp-controller="Place" asp-route-id="@place.Id"
                                    class="flex items-center gap-2 rounded-2xl bg-red-500/20 px-4 py-2.5 text-sm font-medium backdrop-blur-md transition hover:bg-red-500/40">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        @* Pour les séparateurs : 3 Place + 2 separateur  *@
                        @if ( i%3 < 2 && i != Model.Places.Count - 1)
                        {
                        <img src="~/images/place-separator.png" class="h-85 w-auto" />
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>