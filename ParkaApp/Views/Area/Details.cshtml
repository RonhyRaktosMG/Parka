@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Area Details";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-0">
                <i class="bi bi-map-fill me-2"></i>@Model.Name
            </h1>
            <p class="text-muted mb-0">View details and manage parking places</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-2"></i>Edit Area
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow">
                <div class="card-header bg-gradient text-white border-0">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Area Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>ID:</strong>
                        <p class="text-muted">@Model.Id</p>
                    </div>
                    <div class="mb-3">
                        <strong>Name:</strong>
                        <p class="text-muted">@Model.Name</p>
                    </div>
                    <div class="mb-3">
                        <strong>Address:</strong>
                        <p class="text-muted">@Model.Address</p>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Latitude:</strong>
                            <p class="text-muted">@Model.Latitude.ToString("F6")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Longitude:</strong>
                            <p class="text-muted">@Model.Longitude.ToString("F6")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow">
                <div class="card-header bg-gradient text-white border-0">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h3 style="color: #667eea; font-weight: 700;">@Model.Places.Count</h3>
                                <p class="text-muted mb-0">Total Places</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h3 style="color: #10b981; font-weight: 700;">@Model.Places.Count(p => p.Status == PlaceStatus.Available)</h3>
                                <p class="text-muted mb-0">Available</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <h3 style="color: #ef4444; font-weight: 700;">@Model.Places.Count(p => p.Status == PlaceStatus.Occupied)</h3>
                                <p class="text-muted mb-0">Occupied</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow">
        <div class="card-header bg-gradient text-white border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-geo-alt-fill me-2"></i>Parking Places</h5>
            <a asp-action="Create" asp-controller="Place" asp-route-areaId="@Model.Id" class="btn btn-sm btn-light">
                <i class="bi bi-plus-circle me-1"></i>Add Place
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.Places.Count == 0)
            {
                <div class="p-4 text-center">
                    <p class="text-muted mb-3">No parking places in this area yet</p>
                    <a asp-action="Create" asp-controller="Place" asp-route-areaId="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Create First Place
                    </a>
                </div>
            }
            else
            {
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var place in Model.Places)
                        {
                            string statusBadge = place.Status switch
                            {
                                PlaceStatus.Available => "badge-success",
                                PlaceStatus.Occupied => "badge-danger",
                                PlaceStatus.Reserved => "badge-warning",
                                _ => "badge-secondary"
                            };
                            <tr>
                                <td>
                                    <strong>@place.Code</strong>
                                </td>
                                <td>
                                    <span class="badge @statusBadge">@place.Status</span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-controller="Place" asp-route-id="@place.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    <a asp-action="Delete" asp-controller="Place" asp-route-id="@place.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                    <a asp-action="AssignPlace" asp-controller="Occupation" asp-route-placeId="@place.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-plus-circle me-1"></i>Assign Place
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
