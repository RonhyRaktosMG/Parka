@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Supprimer Zone";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Supprimer une Zone</span>
        <span class="c1">Cette action est irréversible</span>

        <!-- Warning Box -->
        <div class="mb-8 rounded-lg border border-red-500/50 bg-red-500/10 p-5" style="margin-bottom: 32px;">
            <div class="flex items-start gap-3">
                <i class="bi bi-exclamation-triangle text-xl text-red-400" style="margin-top: 4px;"></i>
                <div>
                    <p class="font-semibold text-red-300" style="margin: 0;">Attention</p>
                    <p class="text-sm text-red-300/80 mt-2" style="margin: 0;">
                        Cette action est irréversible. Toutes les places de parking associées seront également supprimées.
                    </p>
                </div>
            </div>
        </div>

        <!-- Confirmation Text -->
        <div style="text-align: center; margin-bottom: 32px;">
            <p style="color: #e0f2ff; margin-bottom: 8px;">
                Êtes-vous sûr de vouloir supprimer la zone
            </p>
            <p style="font-weight: 700; font-size: 1.1rem; color: white; margin: 8px 0 0 0;">
                « @Model.Name » ?
            </p>
            
            @if (Model.Places?.Any() == true)
            {
                <p style="margin-top: 16px; font-size: 0.9rem; color: #ff6b6b; font-weight: 600;">
                    Cette zone contient <strong>@Model.Places.Count</strong> place(s) de parking.
                </p>
            }
        </div>

        <form asp-action="Delete" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button" style="background-color: #d9641e;">
                    <i class="bi bi-trash me-2"></i>
                    Oui, Supprimer
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>