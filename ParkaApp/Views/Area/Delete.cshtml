@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Delete Area";
}

<div class="max-w-md mx-auto">
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
        
        <!-- Header -->
        <div class="bg-(--color-primary) text-white px-8 py-7">
            <h1 class="text-3xl font-semibold flex items-center gap-3">
                <i class="bi bi-trash"></i>
                Delete Area
            </h1>
            <p class="mt-2 text-white/80">This action cannot be undone</p>
        </div>

        <div class="p-8">
            <!-- Warning Box -->
            <div class="mb-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">
                <div class="flex items-start gap-3">
                    <i class="bi bi-exclamation-triangle text-2xl text-amber-600 mt-0.5"></i>
                    <div>
                        <p class="font-semibold text-amber-800">Attention</p>
                        <p class="text-sm text-amber-700 mt-1 leading-relaxed">
                            Cette action est irréversible. Toutes les places de parking associées seront également supprimées.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Confirmation Text -->
            <div class="text-center mb-8">
                <p class="text-(--color-secondary) text-lg">
                    Êtes-vous sûr de vouloir supprimer la zone
                </p>
                <p class="font-semibold text-xl text-(--color-secondary) mt-2">
                    « @Model.Name » ?
                </p>
                
                @if (Model.Places?.Any() == true)
                {
                    <p class="mt-4 text-sm text-red-600 font-medium">
                        Cette zone contient <strong>@Model.Places.Count</strong> place(s) de parking.
                    </p>
                }
            </div>

            <!-- Buttons -->
            <form asp-action="Delete" method="post">
                <div class="flex gap-4">
                    <button type="submit" 
                            class="flex-1 bg-red-400 transition text-white font-semibold py-4 rounded-2xl flex items-center justify-center gap-2 shadow-sm">
                        <i class="bi bi-trash"></i>
                        Oui, Supprimer
                    </button>

                    <a asp-action="Index" 
                       class="flex-1 border border-gray-300 hover:bg-gray-50 transition text-(--color-secondary) font-semibold py-4 rounded-2xl flex items-center justify-center gap-2">
                        <i class="bi bi-x-circle"></i>
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>