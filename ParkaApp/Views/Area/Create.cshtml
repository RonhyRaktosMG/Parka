@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Create Area";
}

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-4xl font-bold text-white">Create New Area</h1>
            <p class="mt-2 text-lg text-white/70">Cliquez sur la carte pour sélectionner l'emplacement</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Form -->
        <div class="lg:col-span-5">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8 text-white">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="bg-red-500/20 border border-red-500/50 text-red-200 p-4 rounded mb-6"></div>
                    <div class="space-y-8">
                        
                        <!-- Name -->
                        <div>
                            <label asp-for="Name" class="block text-sm font-semibold text-white mb-2">
                                <i class="bi bi-tag me-2"></i>Area Name
                            </label>
                            <input asp-for="Name" 
                                   class="w-full px-5 py-3.5 border border-white/30 rounded-2xl bg-white/10 text-white focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400 transition"
                                   placeholder="Ex: Parking Centre-Ville" />
                            <span asp-validation-for="Name" class="text-red-300 text-sm mt-1.5 block"></span>
                        </div>

                        <!-- Address -->
                        <div>
                            <label asp-for="Address" class="block text-sm font-semibold text-white mb-2">
                                <i class="bi bi-house-door me-2"></i>Address
                            </label>
                            <input asp-for="Address" 
                                   class="w-full px-5 py-3.5 border border-white/30 rounded-2xl bg-white/10 text-white focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400 transition"
                                   placeholder="Ex: 123 Avenue de l'Indépendance" />
                            <span asp-validation-for="Address" class="text-red-300 text-sm mt-1.5 block"></span>
                        </div>

                        <!-- Coordinates -->
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <label asp-for="Latitude" class="block text-sm font-semibold text-white mb-2">
                                    <i class="bi bi-geo-alt me-2"></i>Latitude
                                </label>
                                <input asp-for="Latitude" id="latInput"
                                       class="w-full px-5 py-3.5 border border-white/30 rounded-2xl bg-white/10 text-white font-mono focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400 transition"
                                       placeholder="-18,8792" readonly />
                                <span asp-validation-for="Latitude" class="text-red-300 text-sm mt-1.5 block"></span>
                            </div>
                            <div>
                                <label asp-for="Longitude" class="block text-sm font-semibold text-white mb-2">
                                    <i class="bi bi-geo-alt me-2"></i>Longitude
                                </label>
                                <input asp-for="Longitude" id="lngInput"
                                       class="w-full px-5 py-3.5 border border-white/30 rounded-2xl bg-white/10 text-white font-mono focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-400 transition"
                                       placeholder="47,5079" readonly />
                                <span asp-validation-for="Longitude" class="text-red-300 text-sm mt-1.5 block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-4 mt-10">
                        <button type="submit" 
                                class="flex-1 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] transition text-white font-semibold py-4 rounded-2xl flex items-center justify-center gap-2">
                            <i class="bi bi-check-circle"></i>
                            Create Area
                        </button>
                        <a asp-action="Index" 
                           class="flex-1 border border-white/30 hover:bg-white/5 transition text-white font-semibold py-4 rounded-2xl flex items-center justify-center gap-2">
                            <i class="bi bi-x-circle"></i>
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Map -->
        <div class="lg:col-span-7 bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-4 border-b border-gray-100 bg-gray-50">
                <p class="text-sm font-medium text-gray-700">Cliquez sur la carte pour sélectionner les coordonnées</p>
            </div>
            <div id="map" class="h-[560px] w-full"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const map = L.map('map').setView([-18.8792, 47.5079], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let marker;

        map.on('click', function (e) {
            let lat = e.latlng.lat.toFixed(6);
            let lng = e.latlng.lng.toFixed(6);

            // Remplacer le point par une virgule
            lat = lat.replace('.', ',');
            lng = lng.replace('.', ',');

            // Mise à jour des champs
            document.getElementById('latInput').value = lat;
            document.getElementById('lngInput').value = lng;

            // Supprimer l'ancien marker
            if (marker) {
                map.removeLayer(marker);
            }

            // Ajouter nouveau marker (on garde le point pour Leaflet)
            marker = L.marker([e.latlng.lat, e.latlng.lng]).addTo(map)
                .bindPopup(`<b>Position sélectionnée</b><br>Lat: ${lat}<br>Lng: ${lng}`)
                .openPopup();
        });
    });
</script>