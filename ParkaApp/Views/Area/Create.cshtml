@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Créer une Zone";
}

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-4xl font-bold text-white">Créer une Nouvelle Zone</h1>
            <p class="mt-2 text-lg text-white/70">Cliquez sur la carte pour sélectionner l'emplacement</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Form -->
        <div class="lg:col-span-5">
            <div class="form-container mx-auto max-w-2xl">
                <div class="form">
                    <span class="heading">Créer une Nouvelle Zone</span>
                    <span class="c1">Ajoutez une zone de stationnement ou de service</span>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                        <!-- Name -->
                        <div class="input-group">
                            <label asp-for="Name" class="label">
                                <i class="bi bi-tag me-2"></i>Nom de la Zone
                            </label>
                            <input asp-for="Name"
                                class="input"
                                placeholder="Ex: Parking Centre-Ville" />
                            <span asp-validation-for="Name" class="error-msg"></span>
                        </div>

                        <!-- Address -->
                        <div class="input-group">
                            <label asp-for="Address" class="label">
                                <i class="bi bi-house-door me-2"></i>Adresse
                            </label>
                            <input asp-for="Address"
                                class="input"
                                placeholder="Ex: 123 Avenue de l'Indépendance" />
                            <span asp-validation-for="Address" class="error-msg"></span>
                        </div>

                        <!-- Coordinates -->
                        <div class="grid grid-cols-2 gap-6">
                            <div class="input-group">
                                <label asp-for="Latitude" class="label">
                                    <i class="bi bi-geo-alt me-2"></i>Latitude
                                </label>
                                <input asp-for="Latitude" id="latInput"
                                    class="input font-mono"
                                    placeholder="-18.8792" readonly />
                                <span asp-validation-for="Latitude" class="error-msg"></span>
                            </div>

                            <div class="input-group">
                                <label asp-for="Longitude" class="label">
                                    <i class="bi bi-geo-alt me-2"></i>Longitude
                                </label>
                                <input asp-for="Longitude" id="lngInput"
                                    class="input font-mono"
                                    placeholder="47.5079" readonly />
                                <span asp-validation-for="Longitude" class="error-msg"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="button-container">
                            <button type="submit" class="send-button">
                                <i class="bi bi-check-circle me-2"></i>
                                Créer la Zone
                            </button>   

                            <a asp-action="Index" class="reset-button">
                                <i class="bi bi-x-circle me-2"></i>
                                Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Map -->
        <div class="lg:col-span-7 bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-4 border-b border-gray-100 bg-gray-50">
                <p class="text-sm font-medium text-gray-700">Cliquez sur la carte pour sélectionner les coordonnées</p>
            </div>
            <div id="map" class="h-140 w-full"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const map = L.map('map').setView([-18.8792, 47.5079], 13);

        @* L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map); *@

        L.tileLayer(
            'https://server.arcgisonline.com/ArcGIS/rest/services/' +
            'World_Imagery/MapServer/tile/{z}/{y}/{x}',
            {
            attribution:
                '&copy; Esri & contributors'
            }
        ).addTo(map);

        let marker;

        map.on('click', function (e) {
            let lat = e.latlng.lat.toFixed(6);
            let lng = e.latlng.lng.toFixed(6);

            // Remplacer le point par une virgule
            lat = lat.replace('.', ',');
            lng = lng.replace('.', ',');

            // Mise à jour des champs
            document.getElementById('latInput').value = lat;
            document.getElementById('lngInput').value = lng;

            // Supprimer l'ancien marker
            if (marker) {
                map.removeLayer(marker);
            }

            // Ajouter nouveau marker
            marker = L.marker([e.latlng.lat, e.latlng.lng]).addTo(map)
                .bindPopup(`<b>Position sélectionnée</b><br>Lat: ${lat}<br>Lng: ${lng}`)
                .openPopup();
        });
    });
</script>