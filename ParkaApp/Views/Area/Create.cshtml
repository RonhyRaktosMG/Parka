@model ParkaApp.Models.Area

@{
    ViewData["Title"] = "Create Area";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Create New Area
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-tag me-2"></i>Area Name
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g., Downtown Parking" />
                        <span asp-validation-for="Name" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Address" class="form-label">
                            <i class="bi bi-house me-2"></i>Address
                        </label>
                        <input asp-for="Address" class="form-control form-control-lg" placeholder="e.g., 123 Main Street" />
                        <span asp-validation-for="Address" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Latitude" class="form-label">
                                    <i class="bi bi-geo me-2"></i>Latitude
                                </label>
                                <input asp-for="Latitude" class="form-control form-control-lg" placeholder="e.g., 40.7128" />
                                <span asp-validation-for="Latitude" class="invalid-feedback d-block mt-2"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Longitude" class="form-label">
                                    <i class="bi bi-geo me-2"></i>Longitude
                                </label>
                                <input asp-for="Longitude" class="form-control form-control-lg" placeholder="e.g., -74.0060" />
                                <span asp-validation-for="Longitude" class="invalid-feedback d-block mt-2"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-check-circle me-2"></i>Create Area
                        </button>
                        <a asp-action="Index" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>