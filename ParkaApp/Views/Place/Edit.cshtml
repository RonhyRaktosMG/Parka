@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Modifier Place";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Modifier la Place</span>
        <span class="c1">Mettez à jour les informations de la place de parking</span>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Place Code -->
            <div class="input-group">
                <label asp-for="Code" class="label">
                    <i class="bi bi-code-square me-2"></i>Code de la Place
                </label>
                <input asp-for="Code" 
                       class="input"
                       placeholder="Ex: A001, P-12, B025" />
                <span asp-validation-for="Code" class="error-msg"></span>
            </div>

            <!-- Status -->
            <div class="input-group">
                <label asp-for="Status" class="label">
                    <i class="bi bi-circle-fill me-2"></i>Statut
                </label>
                <select asp-for="Status" class="input">
                    <option value="">-- Sélectionnez un statut --</option>
                    <option value="Available">Disponible</option>
                    <option value="Occupied">Occupée</option>
                    <option value="Reserved">Réservée</option>
                </select>
                <span asp-validation-for="Status" class="error-msg"></span>
            </div>

            <!-- Parking Area -->
            <div class="input-group">
                <label asp-for="AreaId" class="label">
                    <i class="bi bi-map me-2"></i>Zone de Parking
                </label>
                <input asp-for="AreaId" 
                       type="number"
                       class="input"
                       placeholder="Entrez l'ID de la zone" />
                <span asp-validation-for="AreaId" class="error-msg"></span>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Mettre à jour
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>