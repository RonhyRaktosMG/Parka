@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Edit Place";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-pencil-square me-2"></i>Edit Parking Place
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div class="form-group">
                        <label asp-for="Code" class="form-label">
                            <i class="bi bi-code-square me-2"></i>Place Code
                        </label>
                        <input asp-for="Code" class="form-control form-control-lg" />
                        <span asp-validation-for="Code" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status" class="form-label">
                            <i class="bi bi-circle-fill me-2"></i>Status
                        </label>
                        <select asp-for="Status" class="form-select form-select-lg">
                            <option value="Available" style="color: #10b981;">Available</option>
                            <option value="Occupied" style="color: #ef4444;">Occupied</option>
                            <option value="Reserved" style="color: #f59e0b;">Reserved</option>
                        </select>
                        <span asp-validation-for="Status" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AreaId" class="form-label">
                            <i class="bi bi-map me-2"></i>Parking Area
                        </label>
                        <input asp-for="AreaId" class="form-control form-control-lg" type="number" />
                        <span asp-validation-for="AreaId" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-check-circle me-2"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>