@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Edit Place";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-lg overflow-hidden text-white">
        <div class="bg-blue-600/50 to-blue-700/50 text-white p-6">
            <h3 class="text-2xl font-bold m-0 flex items-center gap-2 text-white">
                <i class="bi bi-pencil-square"></i>Edit Parking Place
            </h3>
        </div>
        <div class="p-6">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-500/20 border border-red-500/50 text-red-200 p-4 rounded mb-6"></div>
                <div class="mb-6">
                    <label asp-for="Code" class="block text-white font-semibold mb-2">
                        <i class="bi bi-code-square me-2"></i>Place Code
                    </label>
                    <input asp-for="Code" class="w-full px-4 py-2 border border-white/30 rounded-lg bg-white/10 text-white focus:outline-none focus:ring-2 focus:ring-blue-400" />
                    <span asp-validation-for="Code" class="text-red-300 text-sm mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Status" class="block text-white font-semibold mb-2">
                        <i class="bi bi-circle-fill me-2"></i>Status
                    </label>
                    <select asp-for="Status" class="w-full px-4 py-2 border border-white/30 rounded-lg bg-white/10 text-white focus:outline-none focus:ring-2 focus:ring-blue-400 [color-scheme:dark]">
                        <option value="Available">Available</option>
                        <option value="Occupied">Occupied</option>
                        <option value="Reserved">Reserved</option>
                    </select>
                    <span asp-validation-for="Status" class="text-red-300 text-sm mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="AreaId" class="block text-white font-semibold mb-2">
                        <i class="bi bi-map me-2"></i>Parking Area
                    </label>
                    <input asp-for="AreaId" class="w-full px-4 py-2 border border-white/30 rounded-lg bg-white/10 text-white focus:outline-none focus:ring-2 focus:ring-blue-400" type="number" />
                    <span asp-validation-for="AreaId" class="text-red-300 text-sm mt-1 block"></span>
                </div>

                <div class="flex gap-3">
                    <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition flex items-center justify-center gap-2">
                        <i class="bi bi-check-circle"></i>Save Changes
                    </button>
                    <a asp-action="Details" asp-controller="Area" asp-route-id="@Model.AreaId" class="px-6 py-3 bg-gray-500 text-white font-semibold rounded-lg hover:bg-gray-600 transition flex items-center justify-center gap-2"> 
                        <i class="bi bi-x-circle"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>