@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Créer Place";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Créer une Nouvelle Place</span>
        <span class="c1">Ajoutez une place de parking à la zone #@Model.AreaId</span>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Place Code -->
            <div class="input-group">
                <label asp-for="Code" class="label">
                    <i class="bi bi-code-square me-2"></i>Code de la Place
                </label>
                <input asp-for="Code" 
                       class="input"
                       placeholder="Ex: A001, P-12, B025" />
                <span asp-validation-for="Code" class="error-msg"></span>
            </div>

            <!-- Parking Area -->
            <input asp-for="AreaId" 
                       type="hidden" />


            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Créer
                </button>

                <a asp-controller="Area" asp-action="Details" asp-route-id="@Model.AreaId" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>