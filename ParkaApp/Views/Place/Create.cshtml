@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Créer Place";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Créer une Nouvelle Place</span>
        <span class="c1">Ajoutez une place de parking à une zone</span>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Place Code -->
            <div class="input-group">
                <label asp-for="Code" class="label">
                    <i class="bi bi-code-square me-2"></i>Code de la Place
                </label>
                <input asp-for="Code" 
                       class="input"
                       placeholder="Ex: A001, P-12, B025" />
                <span asp-validation-for="Code" class="error-msg"></span>
            </div>

            <!-- Parking Area -->
            <div class="input-group">
                <label asp-for="AreaId" class="label">
                    <i class="bi bi-map me-2"></i>Zone de Parking
                </label>
                <input asp-for="AreaId" 
                       type="number"
                       class="input"
                       placeholder="Entrez l'ID de la zone" />
                <span asp-validation-for="AreaId" class="error-msg"></span>
                <small style="display: block; color: #a5c4d9; font-size: 0.85rem; margin-top: 8px;">
                    Entrez l'ID de la zone de parking à laquelle cette place appartient
                </small>
            </div>

            <!-- Initial Status Info -->
            <div style="background-color: rgba(217, 100, 30, 0.1); border: 1px solid rgba(217, 100, 30, 0.3); border-left: 3px solid #d3f35f; border-radius: 4px; padding: 16px; margin-bottom: 24px;">
                <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <i class="bi bi-info-circle" style="font-size: 1.2rem; color: #d3f35f; margin-top: 2px;"></i>
                    <div>
                        <p style="font-weight: 600; color: white; margin: 0 0 8px 0;">Statut Initial</p>
                        <p style="font-size: 0.9rem; color: #a5c4d9; margin: 0;">
                            Cette place de parking sera créée avec le statut <strong>Disponible</strong> par défaut.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Créer
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>