@model ParkaApp.Models.Place

@{
    ViewData["Title"] = "Create Place";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Create New Parking Place
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="form-group">
                        <label asp-for="Code" class="form-label">
                            <i class="bi bi-code-square me-2"></i>Place Code
                        </label>
                        <input asp-for="Code" class="form-control form-control-lg" placeholder="e.g., P001, A-01" />
                        <span asp-validation-for="Code" class="invalid-feedback d-block mt-2"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AreaId" class="form-label">
                            <i class="bi bi-map me-2"></i>Parking Area
                        </label>
                        <input asp-for="AreaId" class="form-control form-control-lg\" type="number\" placeholder=\"Enter Area ID\" />
                        <span asp-validation-for="AreaId" class="invalid-feedback d-block mt-2"></span>
                        <small class="text-muted\">Select the area where this place is located</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label\">
                            <i class=\"bi bi-info-circle me-2\"></i>Initial Status
                        </label>
                        <div class=\"alert alert-info mb-0\">
                            <p class=\"mb-0\">This place will be created with <strong>Available</strong> status</p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-check-circle me-2"></i>Create Place
                        </button>
                        <a asp-action="Index" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>