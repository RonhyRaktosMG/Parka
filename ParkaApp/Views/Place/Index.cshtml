@model IEnumerable<ParkaApp.Models.Place>

@{
    ViewData["Title"] = "Parking Places";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-0">Parking Places</h1>
        <p class="text-muted mb-0">Manage all parking spaces</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-2"></i>Create New Place
    </a>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <strong>No places found.</strong> Create your first parking place to get started.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else
{
    <div class="row">
        @foreach (var place in Model)
        {
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-gradient text-white border-0 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-geo-alt-fill me-2"></i>@place.Code
                        </h5>
                        @{
                            string statusBadge = place.Status switch
                            {
                                PlaceStatus.Available => "badge-success",
                                PlaceStatus.Occupied => "badge-danger",
                                PlaceStatus.Reserved => "badge-warning",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @statusBadge">@place.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <strong>Status:</strong>
                            <p class="text-muted mb-0">@place.Status</p>
                        </div>
                        <div>
                            <strong>Area:</strong>
                            @if (place.Area != null)
                            {
                                <p class="text-muted mb-0">@place.Area.Name</p>
                            }
                            else
                            {
                                <p class="text-muted mb-0"><em>No Area Assigned</em></p>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-light border-0 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@place.Id" class="btn btn-sm btn-primary flex-grow-1">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@place.Id" class="btn btn-sm btn-danger flex-grow-1">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
