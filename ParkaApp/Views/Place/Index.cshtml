@model IEnumerable<ParkaApp.Models.Place>

@{
    ViewData["Title"] = "Parking Places";
}

<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-lg p-6 mb-6 text-white">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-white mb-0">Parking Places</h1>
            <p class="text-white/70 mb-0">Manage all parking spaces</p>
        </div>
        <a asp-action="Create" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold inline-flex items-center gap-2">
            <i class="bi bi-plus-circle"></i>Create New Place
        </a>
    </div>
</div>

@if (Model.Count() == 0)
{
    <div class="bg-blue-50 border-l-4 border-blue-600 p-4 rounded">
        <p class="text-blue-800 flex items-center gap-2 m-0">
            <i class="bi bi-info-circle"></i>
            <strong>No places found.</strong> Create your first parking place to get started.
        </p>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var place in Model)
        {
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-lg overflow-hidden hover:shadow-lg transition flex flex-col text-white">
                <div class="bg-linear-to-r from-blue-600 to-blue-700 text-white p-4 flex justify-between items-center">
                    <h5 class="m-0 font-bold text-lg flex items-center gap-2">
                        <i class="bi bi-geo-alt-fill"></i>@place.Code
                    </h5>
                    @{
                        string statusColor = place.Status switch
                        {
                            PlaceStatus.Available => "bg-green-200 text-green-800",
                            PlaceStatus.Occupied => "bg-red-200 text-red-800",
                            PlaceStatus.Reserved => "bg-yellow-200 text-yellow-800",
                            _ => "bg-gray-200 text-gray-800"
                        };
                    }
                    <span class="px-3 py-1 bg-white text-blue-600 text-xs font-bold rounded">@place.Status</span>
                </div>
                <div class="p-4 flex-1">
                    <div class="mb-4">
                        <strong class="text-gray-900">Status:</strong>
                        <p class="text-gray-600 mb-0">@place.Status</p>
                    </div>
                    <div>
                        <strong class="text-gray-900">Area:</strong>
                        @if (place.Area != null)
                        {
                            <p class="text-gray-600 mb-0">@place.Area.Name</p>
                        }
                        else
                        {
                            <p class="text-gray-600 mb-0 italic">No Area Assigned</p>
                        }
                    </div>
                </div>
                <div class="bg-gray-50 border-t border-gray-200 p-3 flex gap-2">
                    <a asp-action="Edit" asp-route-id="@place.Id" class="flex-1 px-3 py-2 bg-blue-600 text-white text-sm font-semibold rounded hover:bg-blue-700 transition text-center">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@place.Id" class="flex-1 px-3 py-2 bg-red-600 text-white text-sm font-semibold rounded hover:bg-red-700 transition text-center">
                        <i class="bi bi-trash me-1"></i>Delete
                    </a>
                </div>
            </div>
        }
    </div>
}
