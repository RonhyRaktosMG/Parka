@model ParkaApp.Models.Occupation

@{
    ViewData["Title"] = "Modifier Occupation";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Modifier l'Occupation</span>
        <span class="c1">Mettez à jour les informations de l'occupation</span>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Id" />

            <!-- ClientId -->
            <div class="input-group">
                <label asp-for="ClientId" class="label">
                    <i class="bi bi-person me-2"></i>ID du Client
                </label>
                <input asp-for="ClientId" 
                       class="input"
                       type="number"
                       placeholder="Ex: 1, 2, 3" />
                <span asp-validation-for="ClientId" class="error-msg"></span>
            </div>

            <!-- PlaceId -->
            <div class="input-group">
                <label asp-for="PlaceId" class="label">
                    <i class="bi bi-geo me-2"></i>ID de la Place
                </label>
                <input asp-for="PlaceId" 
                       class="input"
                       type="number"
                       placeholder="Ex: 1, 2, 3" />
                <span asp-validation-for="PlaceId" class="error-msg"></span>
            </div>

            <!-- EntryTime -->
            <div class="input-group">
                <label asp-for="EntryTime" class="label">
                    <i class="bi bi-clock me-2"></i>Heure d'Entrée
                </label>
                <input asp-for="EntryTime" 
                       class="input"
                       type="datetime-local"/>
                <span asp-validation-for="EntryTime" class="error-msg"></span>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Mettre à jour
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div> 