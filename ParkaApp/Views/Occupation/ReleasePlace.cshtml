@model ParkaApp.ViewModels.Occupation.ReleasePlaceViewModel

@{
    ViewData["Title"] = "Libérer une Place";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Libérer une Place</span>
        <span class="c1">Confirmez la sortie du véhicule et générez le ticket</span>

        <form asp-action="ReleasePlace" method="post">
            <input type="hidden" asp-for="OccupationId" />
            <input type="hidden" asp-for="PlaceId" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Ticket Information -->
            <div style="background-color: var(--color-secondary); padding: 20px; border-radius: 4px; margin-bottom: 24px; border-left: 3px solid var(--color-primary);">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 0.95rem;">
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Ticket</p>
                        <p style="color: white; font-weight: 700; font-size: 1.1rem; margin: 0;">@Model.OccupationId</p>
                    </div>
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Place</p>
                        <p style="color: white; font-weight: 700; font-size: 1.1rem; margin: 0;">@Model.PlaceId</p>
                    </div>
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Plaque</p>
                        <p style="color: white; margin: 0;">@Model.CarPlate</p>
                    </div>
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Durée</p>
                        <p style="color: white; margin: 0;">@Model.FormattedDuration</p>
                    </div>
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Entrée</p>
                        <p style="color: white; margin: 0; font-size: 0.9rem;">@Model.EntryTime.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div>
                        <p style="color: #e0f2ff; font-weight: 600; margin: 0 0 4px 0;">Sortie</p>
                        <p style="color: white; margin: 0; font-size: 0.9rem;">@Model.ExitTime.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>

            <!-- Total Cost -->
            <div style="background: linear-gradient(135deg, rgba(237, 125, 39, 0.1), rgba(211, 243, 95, 0.05)); padding: 20px; border-radius: 4px; border-left: 3px solid var(--color-accent); margin-bottom: 24px;">
                <p style="color: #d3f35f; font-weight: 600; margin: 0 0 8px 0;">Coût Total</p>
                <p style="color: white; font-weight: 800; font-size: 1.5rem; margin: 0;">@Model.TotalCost <span style="font-size: 1rem; color: #d3f35f;">Ar</span></p>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Confirmer la Sortie
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>