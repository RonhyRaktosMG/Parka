@model ParkaApp.ViewModels.Occupation.ReleasePlaceViewModel

@{
    ViewData["Title"] = "Release Parking Place";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Release Parking Place
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="ReleasePlace" method="post">
                    <input type="hidden" asp-for="OccupationId" />
                    <input type="hidden" asp-for="PlaceId" />

                    <p class="mb-4">
                        Are you sure you want to release the parking place
                        <strong>@Model.OccupationId</strong>?
                    </p>

                    @* Ticket for the occupation *@
                    <div class="mb-3">
                        <p>Ticket id: @Model.OccupationId</p>
                        <p>Place id: @Model.PlaceId</p>
                        <p>Car plate: @Model.CarPlate</p>
                        <p>Entry time: @Model.EntryTime</p>
                        <p>Exit time: @Model.ExitTime</p>
                        <p>Duration: @Model.FormattedDuration</p>
                        <p>Total cost: @Model.TotalCost Ar</p>
                    </div>

                    <div class="d-flex justify-content-end">
                        <a asp-action="Index" class="btn btn-secondary me-2">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Confirm Release
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>