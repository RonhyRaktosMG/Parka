@model ParkaApp.ViewModels.Occupation.StatisticViewModel

@{
    ViewData["Title"] = "Statistiques";
}

<div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-semibold text-white mb-0">
                Statistiques
            </h1>
            <p class="text-white/70 mt-1">Statistiques des occupations</p>
        </div>
        
    </div>
</div>

<div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden text-white">
    <!-- Date Filter -->
    <div class="p-6">
        <form asp-action="Statistics" method="get">
            <div class="flex items-center space-x-4">
                <label asp-for="StartDate" class="text-white">Date de début:</label>
                <input type="date" id="startDate" asp-for="StartDate" class="bg-(--color-secondary-light) text-white placeholder:text-white/50 border border-white/20 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                <label asp-for="EndDate" class="text-white">Date de fin:</label>
                <input type="date" id="endDate" asp-for="EndDate" class="bg-(--color-secondary-light) text-white placeholder:text-white/50 border border-white/20 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded-md transition">Filtrer</button>
            </div>
        </form>
    </div>

    <div class="p-6">
        <h2 class="text-2xl font-semibold mb-4">Statistiques par Zone</h2>
        <table class="w-full text-sm text-white mb-6">
            <thead>
                <tr class="bg-(--color-secondary-light) border-b border-white/10">
                    <th class="px-6 py-4 text-left font-semibold text-white">Zone</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Nombre d'Occupations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var areaStat in Model.AreaStatistics)
                {
                    <tr class="border-b border-white/10 hover:bg-(--color-secondary-light) transition">
                        <td class="px-6 py-4 font-medium text-white">@areaStat.Key</td>
                        <td class="px-6 py-4 font-medium text-white">@areaStat.Value</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2 class="text-2xl font-semibold mb-4">Statistiques par Place et Zone</h2>
        @foreach (var area in Model.PlaceStatisticsPerArea)
        {
            <h3 class="text-xl font-semibold mt-4 mb-2">@area.Key</h3>
            <table class="w-full text-sm text-white mb-6">
                <thead>
                    <tr class="bg-(--color-secondary-light) border-b border-white/10">
                        <th class="px-6 py-4 text-left font-semibold text-white">Place</th>
                        <th class="px-6 py-4 text-left font-semibold text-white">Nombre d'Occupations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var placeStat in area.Value)
                    {
                        <tr class="border-b border-white/10 hover:bg-(--color-secondary-light) transition">
                            <td class="px-6 py-4 font-medium text-white">@placeStat.Key</td>
                            <td class="px-6 py-4 font-medium text-white">@placeStat.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>