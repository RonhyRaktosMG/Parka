@model ParkaApp.Models.Occupation

@{
    ViewData["Title"] = " Create Occupation";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Create New Occupation
                </h3>
            </div>
            <div class="card-body p-4"> 
                <form asp-action="Create" method="post">
                    <div class="form-group">
                        <label asp-for="ClientId" class="form-label">
                            <i class="bi bi-person me-2"></i>Client ID
                        </label>
                        <input asp-for="ClientId" class="form-control form-control-lg" type="number" placeholder="Enter Client ID" />
                        <span asp-validation-for="ClientId" class="invalid-feedback d-block mt-2"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PlaceId" class="form-label">
                            <i class="bi bi-geo me-2"></i>Place ID
                        </label>
                        <input asp-for="PlaceId" class="form-control form-control-lg" type="number" placeholder="Enter Place ID" />
                        <span asp-validation-for="PlaceId" class="invalid-feedback d-block mt-2"></span>
                    </div>  
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary grow">
                            <i class="bi bi-check-circle me-2"></i>Create Occupation
                        </button>
                        <a asp-action="Index" asp-controller="Area" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>  