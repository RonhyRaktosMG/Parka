@model IEnumerable<ParkaApp.Models.Occupation>

@{
    ViewData["Title"] = "Occupations";
}

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-semibold text-(--color-secondary) mb-0">
                Occupations
            </h1>
            <p class="text-(--color-secondary-light) mt-1">Manage current and past parking occupations</p>
        </div>
        
        @* <a asp-action="Create" 
           class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) text-white font-semibold rounded-2xl hover:bg-(--color-primary-dark) transition">
            <i class="bi bi-plus-lg"></i>
            Create New Occupation
        </a> *@
    </div>
</div>

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="w-full text-sm text-gray-700">
        <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Entry Time</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Exit Time</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Place</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Client</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var occupation in Model)
            {
                <tr class="border-b border-gray-100 hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-medium">
                        @occupation.EntryTime.ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td class="px-6 py-4 font-medium">
                        @if (occupation.ExitTime.HasValue)
                        {
                            @occupation.ExitTime.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-amber-600 font-medium">Still parked</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <span class="font-mono font-semibold">@occupation.Place?.Code</span>
                    </td>
                    <td class="px-6 py-4">
                        @occupation.Client?.Name
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex gap-2">
                            <a asp-action="Edit" asp-route-id="@occupation.Id"
                               class="px-4 py-2 text-xs font-medium bg-blue-100 text-blue-700 rounded-2xl hover:bg-blue-200 transition">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            
                            <a asp-action="Delete" asp-route-id="@occupation.Id"
                               class="px-4 py-2 text-xs font-medium bg-red-100 text-red-700 rounded-2xl hover:bg-red-200 transition">
                                <i class="bi bi-trash"></i> Delete
                            </a>

                            <a asp-action="ReleasePlace" asp-route-id="@occupation.Id"
                               class="px-4 py-2 text-xs font-medium bg-emerald-100 text-emerald-700 rounded-2xl hover:bg-emerald-200 transition">
                                <i class="bi bi-unlock"></i> Release
                            </a>
                            
                            
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center py-16 text-gray-500">
            <i class="bi bi-clock-history text-5xl"></i>
            <p class="mt-3">No occupations found</p>
        </div>
    }
</div>