@model IEnumerable<ParkaApp.Models.Occupation>

@{
    ViewData["Title"] = "Occupations";
}

<div class="min-w-[80vw]">
    <!-- Header -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-semibold text-white mb-0">
                    Occupations
                </h1>
                <p class="text-white/70 mt-1">Gérez les occupations de parking en cours et passées</p>
            </div>
            
            @* <a asp-action="Create" 
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) text-white font-semibold rounded-2xl hover:bg-(--color-primary-dark) transition">
                <i class="bi bi-plus-lg"></i>
                Create New Occupation
            </a> *@


            <a asp-action="Statistics" 
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) text-white font-semibold rounded-2xl hover:bg-(--color-primary-dark) transition">
                <i class="bi bi-bar-chart"></i>
                Statistiques
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden mb-6 ">
        <form asp-action="Index" method="get">
            <div class="flex flex-wrap items-center gap-4 p-4">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Rechercher par client ou plaque d'immatriculation"
                    class="flex-1 min-w-0 px-4 py-2 bg-(--color-secondary-light) text-white rounded-2xl focus:ring-2 focus:ring-(--color-primary) transition" />
                <button type="submit"
                        class="px-6 py-2 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded transition">
                    <i class="bi bi-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>

    <!-- Occupation Table -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden">
        <table class="w-full text-sm text-white">
            <thead>
                <tr class="bg-(--color-secondary-light) border-b border-white/10">
                    <th class="px-6 py-4 text-left font-semibold text-white">Entrée</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Sortie</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Place</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Zone</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Client</th>
                    <th class="px-6 py-4 text-left font-semibold text-white">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var occupation in Model)
                {
                    <tr class="border-b border-white/10 hover:bg-(--color-secondary-light) transition">
                        <td class="px-6 py-4 font-medium text-white">
                            @occupation.EntryTime.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="px-6 py-4 font-medium text-white">
                            @if (occupation.ExitTime.HasValue)
                            {
                                @occupation.ExitTime.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-amber-300 font-medium">Toujours stationnée</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-white">
                            <span class="font-mono font-semibold">@occupation.Place?.Code</span>
                        </td>
                        <td class="px-6 py-4 text-white">
                            @(@occupation.Place?.Area?.Name ?? "--")
                        </td>
                        <td class="px-6 py-4 text-white">
                            @occupation.Client?.Name
                        </td>
                        <td class="px-6 py-4 text-white">
                            <div class="flex gap-2">
                                <a asp-action="Edit" asp-route-id="@occupation.Id"
                                class="px-4 py-2 text-xs font-medium bg-blue-500/30 text-white rounded-2xl hover:bg-blue-500/40 transition">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                
                                <a asp-action="Delete" asp-route-id="@occupation.Id"
                                class="px-4 py-2 text-xs font-medium bg-red-500/30 text-white rounded-2xl hover:bg-red-500/40 transition">
                                    <i class="bi bi-trash"></i> Supprimer
                                </a>

                                @if (!occupation.ExitTime.HasValue)
                                {
                                <a asp-action="ReleasePlace" asp-route-id="@occupation.Id"
                                class="px-4 py-2 text-xs font-medium bg-emerald-500/30 text-white rounded-2xl hover:bg-emerald-500/40 transition">
                                    <i class="bi bi-unlock"></i> Libérer
                                </a>
                                }
                                
                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-16 text-white/50">
                <i class="bi bi-clock-history text-5xl"></i>
                <p class="mt-3">Aucune occupation trouvée</p>
            </div>
        }
    </div>
</div>