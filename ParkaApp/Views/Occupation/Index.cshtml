@model IEnumerable<ParkaApp.Models.Occupation>
@{
    ViewData["Title"] = "Occupations";
}

<div class="min-w-[80vw] space-y-4">

    <!-- Header -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-semibold">Occupations</h1>
                <p class="text-white/70 mt-1">Gérez les occupations de parking en cours et passées</p>
            </div>
            <a asp-action="Statistics" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-(--color-primary) text-white font-semibold rounded-2xl hover:bg-(--color-primary-dark) transition">
                <i class="bi bi-bar-chart"></i>
                Statistiques
            </a>
        </div>
    </div>

    <!-- Filter -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-4 mb-6">
        <form asp-action="Index" method="get" class="flex gap-4">
            <input type="text" name="search" value="@ViewBag.Search"
                   placeholder="Rechercher par client ou plaque d'immatriculation"
                   class="flex-1 px-5 py-3 bg-(--color-secondary-light) text-white rounded-2xl focus:ring-2 focus:ring-(--color-primary) outline-none" />
            <button type="submit"
                    class="px-8 py-3 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded-2xl transition flex items-center gap-2">
                <i class="bi bi-search"></i>
                Rechercher
            </button>
        </form>
    </div>


    <!-- Separator -->
    <div class="my-12 md:px-40 flex items-center gap-3">
        <span class="h-px flex-1 border-t border-white"></span>
        <span class="rounded-full border border-white/20 px-3 py-1 text-sm text-white font-medium">X</span>
        <span class="h-px flex-1 border-t border-white"></span>
    </div>

    <!-- List of Cards -->
    <div class="space-y-3">
        @foreach (var occupation in Model)
        {
            <div class="bg-(--color-secondary) rounded py-6 px-12 transition-all">
                <div class="grid grid-cols-1 md:grid-cols-13 gap-x-8 gap-y-5 items-center">

                    <!-- Entrée -->
                    <div class="md:col-span-2">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Entrée</div>
                        <div class="font-medium text-white">
                            @occupation.EntryTime.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <!-- Sortie -->
                    <div class="md:col-span-2">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Sortie</div>
                        @if (occupation.ExitTime.HasValue)
                        {
                            <div class="font-medium text-white">
                                @occupation.ExitTime.Value.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                        else
                        {
                            <div class="text-sm font-medium text-amber-300 rounded-2xl">
                                Toujours stationnée
                            </div>
                        }
                    </div>

                    <!-- Place -->
                    <div class="md:col-span-1">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Place</div>
                        <div class="font-mono font-bold text-2xl text-white">@occupation.Place?.Code</div>
                    </div>

                    <!-- Zone -->
                    <div class="md:col-span-2">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Zone</div>
                        <div class="text-white">@(occupation?.Place?.Area?.Name ?? "--")</div>
                    </div>

                    <!-- Client -->
                    <div class="md:col-span-2">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Client</div>
                        <span class="font-medium text-white">@occupation?.Client?.Name</span>
                    </div>

                    <!-- Plaque -->
                    <div class="md:col-span-2">
                        <div class="text-xs uppercase tracking-widest text-white/50 mb-1">Plaque</div>
                        <span class="font-medium text-white">@occupation?.Client?.CarPlate</span>
                    </div>

                    <!-- Actions -->
                    <div class="md:col-span-2 flex justify-end gap-2">
                        <a asp-action="Edit" asp-route-id="@occupation!.Id"
                        class="px-4 py-4 text-xs justify-center font-medium bg-blue-500/10 hover:bg-blue-500/20 text-white rounded-2xl transition flex items-center gap-1">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@occupation!.Id"
                        class="px-4 py-4 text-xs justify-center font-medium bg-red-500/10 hover:bg-red-500/20 text-white rounded-2xl transition flex items-center gap-1">
                            <i class="bi bi-trash"></i>
                        </a>
                        @if (!occupation!.ExitTime.HasValue)
                        {
                            <a asp-action="ReleasePlace" asp-route-id="@occupation!.Id"
                            class="px-4 py-4 text-xs justify-center font-medium bg-emerald-500/30 hover:bg-emerald-500/50 text-white rounded-2xl transition flex items-center gap-1">
                                <i class="bi bi-unlock"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="bg-(--color-secondary) border border-white/20 rounded-3xl py-24 text-center">
                <i class="bi bi-clock-history text-6xl text-white/30 mb-4"></i>
                <p class="text-white/50 text-lg">Aucune occupation trouvée</p>
            </div>
        }
    </div>
</div>