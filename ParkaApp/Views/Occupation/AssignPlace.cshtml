@model ParkaApp.ViewModels.Occupation.AssignPlaceViewModel

@{
    ViewData["Title"] = "Assigner une Place";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Assigner une Place</span>
        <span class="c1">Affectez un client à une place de parking</span>

        <form asp-action="AssignPlace" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Car Plate -->
            <div class="input-group">
                <label asp-for="CarPlate" class="label">
                    <i class="bi bi-car-front me-2"></i>Plaque d'Immatriculation
                </label>
                <input asp-for="CarPlate" 
                       class="input"
                       type="text"
                       placeholder="Ex: AB-123-CD" />
                <span asp-validation-for="CarPlate" class="error-msg"></span>
            </div>

            <!-- PlaceId (Hidden with Display) -->
            <div class="input-group">
                <label class="label">
                    <i class="bi bi-geo me-2"></i>ID de la Place
                </label>
                <div style="background-color: var(--color-secondary); padding: 14px 18px; border-left: 3px solid var(--color-primary); border-radius: 4px; color: white; font-weight: 600;">
                    @Model.PlaceId
                </div>
                <input asp-for="PlaceId" type="hidden" />
            </div>

            <!-- EntryTime (Hidden with Display) -->
            <div class="input-group">
                <label class="label">
                    <i class="bi bi-clock me-2"></i>Heure d'Entrée
                </label>
                <div style="background-color: var(--color-secondary); padding: 14px 18px; border-left: 3px solid var(--color-primary); border-radius: 4px; color: white; font-weight: 600; font-size: 0.9rem;">
                    @Model.EntryTime.ToString("dd/MM/yyyy HH:mm")
                </div>
                <input asp-for="EntryTime" type="hidden" />
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Assigner
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>  