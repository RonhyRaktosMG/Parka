@model ParkaApp.ViewModels.Occupation.AssignPlaceViewModel

@{
    ViewData["Title"] = " Assign Place to Client";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow">
            <div class="card-header bg-gradient text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Assign Place to Client
                </h3>
            </div>
            <div class="card-body p-4"> 
                <form asp-action="AssignPlace" method="post">
                    <div class="form-group">
                        
                        <label asp-for="CarPlate" class="form-label">
                            
                            <i class="bi bi-person me-2"></i>Car Plate
                        </label>
                        <input asp-for="CarPlate" class="form-control form-control-lg" type="text" placeholder="Enter Car Plate" />
                        <span asp-validation-for="CarPlate" class="invalid-feedback d-block mt-2"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PlaceId" class="form-label">
                            <i class="bi bi-geo me-2"></i>Place ID : @Model.PlaceId
                        </label>
                        <input asp-for="PlaceId" class="form-control form-control-lg" type="hidden" placeholder="Enter Place ID" />
                        <span asp-validation-for="PlaceId" class="invalid-feedback d-block mt-2"></span>
                    </div>  
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-lg btn-primary flex-grow-1">
                            <i class="bi bi-check-circle me-2"></i>Assign Place
                        </button>
                        <a asp-action="Index" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>  