@{
    ViewData["Title"] = "Home";
}

<div class="relative h-[70vh] flex items-center justify-center bg-cover bg-center bg-no-repeat">
    

    <!-- Content -->
    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
        <h1 class="text-6xl md:text-7xl font-bold text-white tracking-tight mb-4">
            ParkaApp
        </h1>
        
        <p class="text-xl md:text-2xl text-white/90 mb-10 max-w-md mx-auto">
            Manage your parking spaces efficiently and intelligently
        </p>

        <a asp-controller="Area" asp-action="Index"
           class="inline-flex items-center gap-3 px-8 py-4 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white text-lg font-semibold rounded-3xl transition-all shadow-lg hover:shadow-xl">
            <i class="bi bi-map"></i>
            View Parking Areas
        </a>
    </div>

</div>