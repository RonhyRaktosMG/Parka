@{
    ViewData["Title"] = "Home Page";
}

<div class="row align-items-center py-5">
    <div class="col-lg-6 mb-4 mb-lg-0">
        <h1 class="page-title">Welcome to ParkaApp</h1>
        <p class="lead text-muted mb-4">
            Manage your parking spaces efficiently with our modern parking management system.
        </p>
        <div class="d-flex gap-3 mb-4">
            <a asp-area="" asp-controller="Area" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-map me-2"></i>View Areas
            </a>
            <a asp-area="" asp-controller="Place" asp-action="Index" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-geo-alt me-2"></i>View Places
            </a>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="bg-light rounded-lg p-5 text-center">
            <i class="bi bi-pin-map" style="font-size: 4rem; color: #667eea;"></i>
            <h3 class="mt-3">Smart Parking Management</h3>
            <p class="text-muted">Track and manage all your parking spaces in one place</p>
        </div>
    </div>
</div>

<hr class="my-5">

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-map-fill" style="font-size: 3rem; color: #667eea;"></i>
                <h5 class="card-title mt-3">Manage Areas</h5>
                <p class="card-text text-muted">Create, edit, and organize parking areas</p>
                <a asp-area="" asp-controller="Area" asp-action="Index" class="btn btn-sm btn-primary">
                    Go to Areas
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-geo-alt-fill" style="font-size: 3rem; color: #764ba2;"></i>
                <h5 class="card-title mt-3">Manage Places</h5>
                <p class="card-text text-muted">Monitor individual parking spaces and their status</p>
                <a asp-area="" asp-controller="Place" asp-action="Index" class="btn btn-sm btn-primary">
                    Go to Places
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-speedometer" style="font-size: 3rem; color: #667eea;"></i>
                <h5 class="card-title mt-3">Real-time Tracking</h5>
                <p class="card-text text-muted">Get instant updates on parking availability</p>
                <a href="#" class="btn btn-sm btn-primary">Learn More</a>
            </div>
        </div>
    </div>
</div>