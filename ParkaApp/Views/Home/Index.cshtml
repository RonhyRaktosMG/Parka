@{
    ViewData["Title"] = "Home Page";
}

<div class="bg-white rounded-lg shadow-lg p-8 mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to ParkaApp</h1>
            <p class="text-lg text-gray-600 mb-6">
                Manage your parking spaces efficiently with our modern parking management system.
            </p>
            <div class="flex gap-4 mb-4">
                <a asp-area="" asp-controller="Area" asp-action="Index" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-2">
                    <i class="bi bi-map"></i>View Areas
                </a>
                <a asp-area="" asp-controller="Place" asp-action="Index" class="px-6 py-3 bg-blue-100 text-blue-600 rounded-lg hover:bg-blue-200 transition flex items-center gap-2">
                    <i class="bi bi-geo-alt"></i>View Places
                </a>
            </div>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-8 text-center">
            <i class="bi bi-pin-map text-6xl text-blue-600 block mb-4"></i>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Smart Parking Management</h3>
            <p class="text-gray-600">Track and manage all your parking spaces in one place</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow-lg p-6 text-center">
        <i class="bi bi-map-fill text-5xl text-blue-600 block mb-4"></i>
        <h5 class="text-xl font-bold text-gray-900 mb-2">Manage Areas</h5>
        <p class="text-gray-600 mb-4">Create, edit, and organize parking areas</p>
        <a asp-area="" asp-controller="Area" asp-action="Index" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
            Go to Areas
        </a>
    </div>
    <div class="bg-white rounded-lg shadow-lg p-6 text-center">
        <i class="bi bi-geo-alt-fill text-5xl text-purple-600 block mb-4"></i>
        <h5 class="text-xl font-bold text-gray-900 mb-2">Manage Places</h5>
        <p class="text-gray-600 mb-4">Monitor individual parking spaces and their status</p>
        <a asp-area="" asp-controller="Place" asp-action="Index" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
            Go to Places
        </a>
    </div>
    <div class="bg-white rounded-lg shadow-lg p-6 text-center">
        <i class="bi bi-speedometer text-5xl text-blue-600 block mb-4"></i>
        <h5 class="text-xl font-bold text-gray-900 mb-2">Real-time Tracking</h5>
        <p class="text-gray-600 mb-4">Get instant updates on parking availability</p>
        <a href="#" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Learn More</a>
    </div>
</div>