@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-3xl mx-auto">
    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-lg p-8 mb-6 text-white">
        <h1 class="text-4xl font-bold text-white mb-6 flex items-center gap-3">
            <i class="bi bi-shield-lock text-blue-400"></i>Privacy Policy
        </h1>

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-info-circle text-blue-400"></i>Information Collection
            </h5>
            <p class="text-white/70">
                ParkaApp collects information about parking areas and places to provide our services. 
                This includes location data, area names, and place status information.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-shield-check text-green-400"></i>Data Protection
            </h5>
            <p class="text-white/70">
                We take the security of your data seriously. All information is encrypted and stored securely 
                on our servers. Access to data is restricted to authorized personnel only.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-eye text-purple-400"></i>Data Usage
            </h5>
            <p class="text-white/70">
                Your data is used solely for managing parking areas and places. We do not sell or share 
                your information with third parties without your consent.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-chat-dots text-blue-400"></i>Contact Us
            </h5>
            <p class="text-white/70">
                If you have any questions about our privacy policy, please contact us at 
                <strong>privacy@parkaapp.com</strong>
            </p>
        </div>
    </div>

    <div class="bg-blue-500/10 border-l-4 border-blue-500 p-4 rounded mb-6">
        <p class="text-white/80 flex items-center gap-2 m-0">
            <i class="bi bi-calendar-check text-blue-400"></i>
            <strong>Last Updated:</strong> May 18, 2026
        </p>
    </div>

    <a asp-action="Index" asp-controller="Home" class="px-6 py-3 bg-blue-500/30 text-white rounded-lg hover:bg-blue-500/40 transition inline-flex items-center gap-2 border border-blue-500/50">
        <i class="bi bi-arrow-left"></i>Back to Home
    </a>
</div>
