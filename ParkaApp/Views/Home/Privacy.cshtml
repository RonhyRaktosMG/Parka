@{
    ViewData["Title"] = "Politique de confidentialité";
}

<div class="max-w-3xl mx-auto">
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-lg p-8 mb-6 text-white">
        <h1 class="text-4xl font-bold text-white mb-6 flex items-center gap-3">
            <i class="bi bi-shield-lock text-blue-400"></i>Politique de confidentialité
        </h1>

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-info-circle text-blue-400"></i>Collecte d'informations
            </h5>
            <p class="text-white/70">
                ParkaApp collecte des informations sur les zones et les places de parking pour fournir ses services.
                Cela inclut les données de localisation, les noms des zones et les informations de statut des places.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-shield-check text-green-400"></i>Protection des données
            </h5>
            <p class="text-white/70">
                Nous prenons la sécurité de vos données très au sérieux. Toutes les informations sont chiffrées et stockées de manière sécurisée
                sur nos serveurs. L'accès aux données est réservé au personnel autorisé uniquement.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-eye text-purple-400"></i>Utilisation des données
            </h5>
            <p class="text-white/70">
                Vos données sont utilisées uniquement pour la gestion des zones et des places de parking.
                Nous ne vendons ni ne partageons vos informations avec des tiers sans votre consentement.
            </p>
        </div>

        <hr class="my-6 border-white/10" />

        <div class="mb-6">
            <h5 class="text-lg font-bold text-white mb-3 flex items-center gap-2">
                <i class="bi bi-chat-dots text-blue-400"></i>Contactez-nous
            </h5>
            <p class="text-white/70">
                Si vous avez des questions sur notre politique de confidentialité, contactez-nous à l'adresse 
                <strong>privacy@parkaapp.com</strong>
            </p>
        </div>
    </div>

    <div class="bg-blue-500/10 border-l-4 border-blue-500 p-4 rounded mb-6">
        <p class="text-white/80 flex items-center gap-2 m-0">
            <i class="bi bi-calendar-check text-blue-400"></i>
            <strong>Dernière mise à jour :</strong> 18 mai 2026
        </p>
    </div>

    <a asp-action="Index" asp-controller="Home" class="px-6 py-3 bg-blue-500/30 text-white rounded-lg hover:bg-blue-500/40 transition inline-flex items-center gap-2 border border-blue-500/50">
        <i class="bi bi-arrow-left"></i>Retour à l'accueil
    </a>
</div>
