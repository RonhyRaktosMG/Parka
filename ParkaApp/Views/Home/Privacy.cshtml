@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="page-title mb-4">
            <i class="bi bi-shield-lock me-2"></i>Privacy Policy
        </h1>

        <div class="card border-0 shadow">
            <div class="card-body p-4">
                <div class="mb-4">
                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-info-circle me-2"></i>Information Collection
                    </h5>
                    <p class="text-muted">
                        ParkaApp collects information about parking areas and places to provide our services. 
                        This includes location data, area names, and place status information.
                    </p>
                </div>

                <hr />

                <div class="mb-4">
                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-shield-check me-2"></i>Data Protection
                    </h5>
                    <p class="text-muted">
                        We take the security of your data seriously. All information is encrypted and stored securely 
                        on our servers. Access to data is restricted to authorized personnel only.
                    </p>
                </div>

                <hr />

                <div class="mb-4">
                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-eye me-2"></i>Data Usage
                    </h5>
                    <p class="text-muted">
                        Your data is used solely for managing parking areas and places. We do not sell or share 
                        your information with third parties without your consent.
                    </p>
                </div>

                <hr />

                <div class="mb-4">
                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-chat-dots me-2"></i>Contact Us
                    </h5>
                    <p class="text-muted mb-0">
                        If you have any questions about our privacy policy, please contact us at 
                        <strong>privacy@parkaapp.com</strong>
                    </p>
                </div>
            </div>
        </div>

        <div class="alert alert-info mt-4" role="alert">
            <i class="bi bi-calendar-check me-2"></i>
            <strong>Last Updated:</strong> May 18, 2026
        </div>

        <a asp-action="Index" asp-controller="Home" class="btn btn-primary mt-3">
            <i class="bi bi-arrow-left me-2"></i>Back to Home
        </a>
    </div>
</div>
