@model ParkaApp.Models.Client

@{
    ViewData["Title"] = "Créer Client";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Créer un Nouveau Client</span>
        <span class="c1">Ajoutez un nouveau client ou visiteur</span>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Car Plate -->
            <div class="input-group">
                <label asp-for="CarPlate" class="label">
                    <i class="bi bi-car-front me-2"></i>Plaque d'Immatriculation
                </label>
                <input asp-for="CarPlate" 
                       class="input"
                       placeholder="Ex: 1234 TAB" />
                <span asp-validation-for="CarPlate" class="error-msg"></span>
            </div>

            <!-- Name -->
            <div class="input-group">
                <label asp-for="Name" class="label">
                    <i class="bi bi-person me-2"></i>Nom du Client
                </label>
                <input asp-for="Name" 
                       class="input"
                       placeholder="Ex: Rasoazanany" />
                <span asp-validation-for="Name" class="error-msg"></span>
            </div>

            <!-- Phone Number -->
            <div class="input-group">
                <label asp-for="PhoneNumber" class="label">
                    <i class="bi bi-telephone me-2"></i>Numéro de Téléphone
                </label>
                <input asp-for="PhoneNumber" 
                       class="input"
                       placeholder="Ex: 034 12 345 67" />
                <span asp-validation-for="PhoneNumber" class="error-msg"></span>
            </div>

            <!-- Is Guest -->
            <div class="input-group">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <input asp-for="IsGuest" type="checkbox" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--color-primary);" />
                    <label asp-for="IsGuest" class="label" style="margin-bottom: 0; font-weight: 500;">
                        Client Invité
                    </label>
                </div>
                <span asp-validation-for="IsGuest" class="error-msg"></span>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Créer
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>