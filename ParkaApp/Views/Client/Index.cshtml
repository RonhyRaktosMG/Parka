@model IEnumerable<ParkaApp.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="min-w-[80vw]">
    <!-- Header -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-semibold text-white mb-0">
                    Clients
                </h1>
                <p class="text-white mt-1">
                    Gérez tous vos clients de parking
                </p>
            </div>
            
            <a asp-action="Create" 
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) text-white font-semibold rounded-2xl hover:bg-(--color-primary-dark) transition">
                <i class="bi bi-plus-lg"></i>
                Créer un Client
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden mb-6 ">
        <form asp-action="Index" method="get">
            <div class="flex flex-wrap items-center gap-4 p-4">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Rechercher par client ou plaque d'immatriculation"
                    class="flex-1 min-w-0 px-4 py-2 bg-(--color-secondary-light) text-white rounded-2xl focus:ring-2 focus:ring-(--color-primary) transition" />
                <button type="submit"
                        class="px-6 py-2 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded transition">
                    <i class="bi bi-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>

    <!-- Separator -->
    <div class="my-12 md:px-40 flex items-center gap-3">
        <span class="h-px flex-1 border-t border-white"></span>
        <span class="rounded-full border border-white/20 px-3 py-1 text-sm text-white font-medium">X</span>
        <span class="h-px flex-1 border-t border-white"></span>
    </div>

    <div class="grid grid-cols-3 gap-3">
        @foreach (var client in Model)
        {
            <div class="max-w-md w-full bg-(--color-secondary) rounded-3xl p-8 pt-16 shadow-2xl text-white space-y-3 relative">

                @if (client.IsGuest)
                {
                    <span class="inline-flex px-3 py-1 text-xs font-medium bg-amber-100 text-amber-700 rounded-2xl position-absolute top-4 right-4">Invité</span>
                }
                else
                {
                    <span class="inline-flex px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-2xl position-absolute top-4 right-4">Régulier</span>
                }

                <!-- Header -->
                <div>
                    <p class="text-sm text-zinc-400 mb-0">Nom</p>
                    <a asp-action="Details" asp-route-id="@client.Id" style="text-decoration: none;">
                        <h2 class="text-3xl font-semibold" style="color: var(--color-primary);">@client.Name</h2>
                    </a>
                </div>

                <!-- CarPlate -->
                <div>
                    <p class="text-sm text-zinc-400 mb-0">CarPlate</p>
                    
                    <div class="relative">
                        <!-- Image de fond de la plaque -->
                        <img src="~/images/car_plate.png" 
                            alt="Plaque" 
                            class="w-full rounded-2xl">

                        <!-- Overlay contenu sur la plaque -->
                        <div class="absolute inset-0 flex flex-col items-center justify-center">

                            <!-- Numéro de plaque -->
                            <div class="text-white text-4xl font-bold tracking-widest drop-shadow-lg">
                                @client.CarPlate
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Phone & Action -->
                <div class="flex justify-between">
                    <div>
                        <p class="text-sm text-zinc-400 mb-0">Phone</p>
                        <p class="text-xl font-medium">@(client.PhoneNumber ?? "--")</p>
                    </div>
                    <div class="flex flex-row gap-3">
                        <a asp-action="Edit" asp-route-id="@client.Id"
                            class="px-4 py-2 bg-blue-100 text-blue-700 rounded-2xl hover:bg-blue-200 transition justify-center align-center inline-flex">
                            <i class="bi bi-pencil flex align-items-center"></i>
                        </a>
                        
                        <a asp-action="Delete" asp-route-id="@client.Id"
                            class="px-4 py-2 bg-red-100 text-red-700 rounded-2xl hover:bg-red-200 transition justify-center align-center inline-flex">
                            <i class="bi bi-trash flex align-items-center"></i>
                        </a>
                    </div>
                </div>

            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-16 text-gray-500">
                <i class="bi bi-people text-5xl"></i>
                <p class="mt-3">Aucun client trouvé</p>
            </div>
        }
    </div>
</div>