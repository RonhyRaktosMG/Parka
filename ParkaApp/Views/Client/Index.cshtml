@model IEnumerable<ParkaApp.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-semibold text-white mb-0">
                Clients
            </h1>
            <p class="text-[var(--color-secondary-light)] mt-1">
                Manage all your parking clients
            </p>
        </div>
        
        <a asp-action="Create" 
           class="inline-flex items-center gap-2 px-6 py-3.5 bg-[var(--color-primary)] text-white font-semibold rounded-2xl hover:bg-[var(--color-primary-dark)] transition">
            <i class="bi bi-plus-lg"></i>
            Create New Client
        </a>
    </div>
</div>

<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden">
    <table class="w-full text-sm text-white">
        <thead>
            <tr class="bg-white/5 border-b border-white/10">
                <th class="px-6 py-4 text-left font-semibold text-white">ID</th>
                <th class="px-6 py-4 text-left font-semibold text-white">Car Plate</th>
                <th class="px-6 py-4 text-left font-semibold text-white">Name</th>
                <th class="px-6 py-4 text-left font-semibold text-white">Phone Number</th>
                <th class="px-6 py-4 text-left font-semibold text-white">Guest</th>
                <th class="px-6 py-4 text-left font-semibold text-white">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr class="border-b border-white/10 hover:bg-white/5 transition">
                    <td class="px-6 py-4 font-medium text-white">@client.Id</td>
                    <td class="px-6 py-4 font-mono font-semibold text-white">@client.CarPlate</td>
                    <td class="px-6 py-4 text-white">
                        @(string.IsNullOrWhiteSpace(client.Name) ? "—" : client.Name)
                    </td>
                    <td class="px-6 py-4 text-white">
                        @(string.IsNullOrWhiteSpace(client.PhoneNumber) ? "—" : client.PhoneNumber)
                    </td>
                    <td class="px-6 py-4">
                        @if (client.IsGuest)
                        {
                            <span class="inline-flex px-3 py-1 text-xs font-medium bg-amber-100 text-amber-700 rounded-2xl">Guest</span>
                        }
                        else
                        {
                            <span class="inline-flex px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-2xl">Regular</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex gap-2">
                            <a asp-action="Edit" asp-route-id="@client.Id"
                               class="px-4 py-2 text-xs font-medium bg-blue-100 text-blue-700 rounded-2xl hover:bg-blue-200 transition">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@client.Id"
                               class="px-4 py-2 text-xs font-medium bg-red-100 text-red-700 rounded-2xl hover:bg-red-200 transition">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center py-16 text-gray-500">
            <i class="bi bi-people text-5xl"></i>
            <p class="mt-3">No clients found</p>
        </div>
    }
</div>