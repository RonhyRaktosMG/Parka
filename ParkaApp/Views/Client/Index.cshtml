@model IEnumerable<ParkaApp.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<div class="bg-white rounded-lg shadow-lg p-6">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-0">@ViewData["Title"]</h1>
        </div>
        <a asp-action="Create" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold">Create New Client</a>
    </div>

    @if (Model.Count() == 0)
    {
        <p class="text-gray-500">No client data available.</p>
    }
    else
    {
        <div class="space-y-2 divide-y">
            @foreach (var client in Model)
            {
                <div class="flex justify-between items-center p-4 hover:bg-gray-50 transition">
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 flex-1">
                        <div>
                            <dt class="font-semibold text-gray-900">ID</dt>
                            <dd class="text-gray-600">@client.Id</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900">Car Plate</dt>
                            <dd class="text-gray-600">@client.CarPlate</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900">Name</dt>
                            <dd class="text-gray-600">@(string.IsNullOrWhiteSpace(client.Name) ? "—" : client.Name)</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900">Phone</dt>
                            <dd class="text-gray-600">@(string.IsNullOrWhiteSpace(client.PhoneNumber) ? "—" : client.PhoneNumber)</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900">Guest</dt>
                            <dd class="text-gray-600">@(client.IsGuest ? "Yes" : "No")</dd>
                        </div>
                    </div>
                    <div class="flex gap-2 ms-4">
                        <a asp-action="Edit" asp-route-id="@client.Id" class="px-3 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition">Edit</a>
                        <a asp-action="Delete" asp-route-id="@client.Id" class="px-3 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition">Delete</a>
                    </div>
                </div>
            }
        </div>
    }
</div>