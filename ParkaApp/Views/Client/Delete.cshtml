@model ParkaApp.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="max-w-md mx-auto">
    <div class="bg-white/10 backdrop-blur-md border-l-4 border-red-500 rounded-lg overflow-hidden text-white">
        <div class="bg-red-600/50 text-white p-6">
            <h3 class="text-2xl font-bold m-0 flex items-center gap-2">
                <i class="bi bi-exclamation-triangle"></i>Delete Client
            </h3>
        </div>
        <div class="p-6">
            <div class="bg-red-500/20 border-l-4 border-red-500 p-4 mb-4">
                <p class="text-red-200 flex items-center gap-2 m-0">
                    <i class="bi bi-exclamation-circle"></i>
                    <strong>Warning!</strong> This action cannot be undone.
                </p>
            </div>
            <p class="text-white mb-2">
                Are you sure you want to delete the client <strong>@Model.Name</strong>?
            </p>
            <p class="text-white/50 text-sm mb-6">
                Current Status: <span class="px-2 py-1 bg-blue-500/30 text-blue-200 text-xs rounded">@Model.IsGuest</span>
            </p>
            <form asp-action="Delete" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-500/20 border border-red-500/50 text-red-200 p-4 rounded mb-6"></div>
                <div class="flex gap-3">
                    <button type="submit" class="flex-1 px-4 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition flex items-center justify-center gap-2">
                        <i class="bi bi-trash"></i>Yes, Delete
                    </button>
                    <a asp-action="Index" class="px-4 py-3 bg-gray-500 text-white font-semibold rounded-lg hover:bg-gray-600 transition flex items-center justify-center gap-2">
                        <i class="bi bi-x-circle"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>