@model ParkaApp.Models.Payment

@{
    ViewData["Title"] = "Modifier Paiement";
}

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Modifier le Paiement</span>
        <span class="c1">Mettez à jour les informations du paiement</span>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- Amount -->
            <div class="input-group">
                <label asp-for="Amount" class="label">
                    <i class="bi bi-cash-coin me-2"></i>Montant (Ar)
                </label>
                <input asp-for="Amount" 
                       class="input"
                       placeholder="Ex: 50000" />
                <span asp-validation-for="Amount" class="error-msg"></span>
            </div>

            <!-- Type -->
            <div class="input-group">
                <label asp-for="Type" class="label">
                    <i class="bi bi-calendar me-2"></i>Type de Paiement
                </label>
                <input asp-for="Type" 
                       class="input"
                       placeholder="Ex: Hourly, Daily, Monthly" />
                <span asp-validation-for="Type" class="error-msg"></span>
            </div>

            <!-- Start Date -->
            <div class="input-group">
                <label asp-for="StartDate" class="label">
                    <i class="bi bi-calendar-event me-2"></i>Date de Début
                </label>
                <input asp-for="StartDate" 
                       class="input"
                       type="date" />
                <span asp-validation-for="StartDate" class="error-msg"></span>
            </div>

            <!-- End Date -->
            <div class="input-group">
                <label asp-for="EndDate" class="label">
                    <i class="bi bi-calendar-check me-2"></i>Date de Fin
                </label>
                <input asp-for="EndDate" 
                       class="input"
                       type="date" />
                <span asp-validation-for="EndDate" class="error-msg"></span>
            </div>

            <!-- Client ID -->
            <div class="input-group">
                <label asp-for="ClientId" class="label">
                    <i class="bi bi-person me-2"></i>ID du Client
                </label>
                <input asp-for="ClientId" 
                       class="input"
                       type="number"
                       placeholder="Ex: 1, 2, 3" />
                <span asp-validation-for="ClientId" class="error-msg"></span>
            </div>

            <!-- Buttons -->
            <div class="button-container">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Mettre à jour
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>