@model ParkaApp.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow border-danger">
            <div class="card-header bg-danger text-white border-0">
                <h3 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Delete Payment
                </h3>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <strong>Warning!</strong> This action cannot be undone.
                </div>
                <p class="mb-4">
                    Are you sure you want to delete the payment <strong>@Model.Id</strong>?
                </p>
                <form asp-action="Delete" method="post">
                    <div asp-validation-summary="ModelOnly" class="bg-red-500/20 border border-red-500/50 text-red-200 p-4 rounded mb-6"></div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-lg btn-danger flex-grow-1">
                            <i class="bi bi-trash me-2"></i>Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-lg btn-secondary">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>