@model IEnumerable<ParkaApp.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="bg-white rounded-lg shadow-lg p-6 mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-0">@ViewData["Title"]</h1>
        </div>
        <a asp-action="Create" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold flex items-center gap-2">
            <i class="bi bi-plus-lg"></i>Create New Payment
        </a>
    </div>
</div>

<div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <table class="w-full text-sm text-gray-700">
        <thead>
            <tr class="bg-gray-100 border-b-2 border-gray-300">
                <th class="px-6 py-3 text-left font-bold text-gray-900">Id</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">Amount</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">Type</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">Start Date</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">End Date</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">Client</th>
                <th class="px-6 py-3 text-left font-bold text-gray-900">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model)
            {
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition">
                    <td class="px-6 py-3">@payment.Id</td>
                    <td class="px-6 py-3">@payment.Amount</td>
                    <td class="px-6 py-3">@payment.Type</td>
                    <td class="px-6 py-3">@payment.StartDate.ToShortDateString()</td>
                    <td class="px-6 py-3">@payment.EndDate.ToShortDateString()</td>
                    <td class="px-6 py-3">@payment.Client?.Name</td>
                    <td class="px-6 py-3 flex gap-2">
                        <a asp-action="Edit" asp-route-id="@payment.Id" class="px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700 transition">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@payment.Id" class="px-2 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700 transition">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </td>
                </tr>  
            }
        </tbody>
    </table>
</div>


