@model IEnumerable<ParkaApp.Models.Payment>


@{
    ViewData["Title"] = "Payments";
}



<h1>@ViewData["Title"]</h1>
<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-lg me-1"></i>Create New Payment
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Amount</th>
            <th>Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Client</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td>@payment.Id</td>
                <td>@payment.Amount</td>
                <td>@payment.Type</td>
                <td>@payment.StartDate.ToShortDateString()</td>
                <td>@payment.EndDate.ToShortDateString()</td>
                <td>@payment.Client?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@payment.Id" class="btn btn-sm btn-secondary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-eye me-1"></i>Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@payment.Id" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </a>
                </td>
            </tr>  
        }
    </tbody>
</table>


