@model IEnumerable<ParkaApp.Models.Payment>
@{
    ViewData["Title"] = "Paiements";
}


<div class="min-w-[80vw]">
    <!-- Header -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl p-6 mb-6 text-white">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-semibold text-white mb-0">
                    Paiements
                </h1>
                <p class="text-white/80 mt-1">
                    Gestion des paiements et abonnements
                </p>
            </div>
            <a asp-action="Create"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded-2xl transition">
                <i class="bi bi-plus-lg"></i>
                Nouveau Paiement
            </a>
            <a asp-action="Statistics"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded-2xl transition">
                <i class="bi bi-bar-chart"></i>
                Statistiques
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-(--color-secondary) backdrop-blur-md border border-white/20 rounded-3xl overflow-hidden mb-6 ">
        <form asp-action="Index" method="get">
            <div class="flex flex-wrap items-center gap-4 p-4">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Rechercher par client ou plaque d'immatriculation"
                    class="flex-1 min-w-0 px-4 py-2 bg-(--color-secondary-light) text-white rounded-2xl focus:ring-2 focus:ring-(--color-primary) transition" />
                <button type="submit"
                        class="px-6 py-2 bg-(--color-primary) hover:bg-(--color-primary-dark) text-white font-semibold rounded transition">
                    <i class="bi bi-search"></i> Rechercher
                </button>
            </div>
        </form>
    </div>

    <!-- Separator -->
    <div class="my-12 md:px-40 flex items-center gap-3">
        <span class="h-px flex-1 border-t border-white"></span>
        <span class="rounded-full border border-white/20 px-3 py-1 text-sm text-white font-medium">X</span>
        <span class="h-px flex-1 border-t border-white"></span>
    </div>

    <!--List -->
    @foreach (var payment in Model)
    {
        <div class="my-4 transition w-full bg-(--color-secondary) rounded overflow-hidden shadow-2xl text-white">
            <div class="px-8 py-2 flex gap-8">
            
                <!-- Main Content: Two Columns -->
                <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-8">

                    <!-- Left Side -->
                    <div class="space-y-1  flex flex-col justify-center">

                        <!-- Client -->
                        <div>
                            <p class="text-zinc-400 text-sm mb-0">Client</p>
                            <span class="text-lg font-bold">@(payment.Client?.Name ?? "—")</span>
                        </div>

                        <!-- CarPlate -->
                        <div>
                            <p class="text-zinc-400 text-sm mb-0">Plaque</p>
                            <div class="relative max-w-42">
                                <!-- Image de fond de la plaque -->
                                <img src="~/images/car_plate.png"
                                    alt="Car Plate"
                                    class="w-full rounded-2xl">
                                
                                <!-- Contenu superposé -->
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="text-white text-md font-bold tracking-widest drop-shadow-md">
                                        @(payment.Client?.CarPlate ?? "—")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Right Side -->
                    <div class="space-y-1border-l border-zinc-700 pl-8 border-l-2">

                        <!-- Amount -->
                        <div>
                            <p class="text-zinc-400 text-sm mb-0">
                                Montant 
                                <span class="ml-12 inline-block text-center mt-2 bg-emerald-500/10 text-emerald-400 text-sm px-4 py-1 rounded-3xl">
                                    @switch(payment.Type)
                                    {
                                        case ParkaApp.Models.PaymentType.Hourly:
                                            @:par heure
                                            break;
                                        case ParkaApp.Models.PaymentType.Daily:
                                            @:Par jour
                                            break;
                                        case ParkaApp.Models.PaymentType.Monthly:
                                            @:Par mois
                                            break;
                                        default:
                                            @:Abonnement
                                            break;
                                    }
                                </span>
                            </p>
                            <span class="text-6xl font-bold text-orange-400">@(payment.Amount.ToString("N0") ?? "—") Ar</span>
                        </div>

                        <!-- Période -->
                        <div>
                            <p class="text-zinc-400 text-sm mb-0">Période</p>
                            <div class="flex items-center gap-3 mt-2 text-sm">
                            <span>@payment.StartDate.ToShortDateString()</span>
                            <span class="text-zinc-500">-</span>
                            <span>@payment.EndDate.ToShortDateString()</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Action Buttons - Sur la même ligne -->
                <div class="flex flex-col gap-4 pt-2 justify-center align-items-center">
                    <a asp-action="Edit" asp-route-id="@payment.Id"
                    class="px-4 py-4 text-xs font-medium bg-blue-500/10 hover:bg-blue-500/20 text-white rounded-2xl transition flex items-center gap-1">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@payment.Id"
                    class="px-4 py-4 text-xs font-medium bg-red-500/10 hover:bg-red-500/20 text-white rounded-2xl transition flex items-center gap-1">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-20 text-white/50">
                <i class="bi bi-credit-card text-6xl mb-4"></i>
                <p class="text-lg">Aucun paiement trouvé</p>
            </div>
        }
    }

</div>