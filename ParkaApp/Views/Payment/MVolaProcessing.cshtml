@model ParkaApp.ViewModels.Payment.MVolaCreatePaymentViewModel


@{
    ViewData["Title"] = "Paiement MVola en cours";
}

<style>
    .mvola-status-card {
        border: 1px solid #d6f5d6;
        background: linear-gradient(135deg, #fff9d8 0%, #f2fff0 100%);
        border-radius: 12px;
        padding: 1rem;
        margin: 1rem 0 1.25rem;
    }

    .mvola-status-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: .75rem;
    }

    .mvola-badge {
        background: #ffd84d;
        color: #2f4f2f;
        border-radius: 999px;
        padding: .25rem .75rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .mvola-loader {
        width: 24px;
        height: 24px;
        border: 3px solid #e2f9e2;
        border-top-color: #00a651;
        border-radius: 50%;
        animation: mvola-spin .8s linear infinite;
    }

    .mvola-status-text {
        color: #2f4f2f;
        font-weight: 600;
    }

    .mvola-sub-text {
        color: #557755;
        font-size: .92rem;
        margin-top: .35rem;
    }

    .mvola-completed .mvola-badge {
        background: #00a651;
        color: #fff;
    }

    .mvola-failed .mvola-badge {
        background: #ffd84d;
        color: #6b4f00;
    }

    .mvola-hidden {
        display: none;
    }

    @@keyframes mvola-spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="form-container mx-auto max-w-2xl">
    <div class="form">
        <span class="heading">Paiement MVola en cours</span>
        <span class="c1">Veuillez patienter pendant le traitement de votre paiement</span>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div id="mvolaStatusCard" class="mvola-status-card">
                <div class="mvola-status-header">
                    <div class="flex items-center gap-3">
                        <div id="mvolaLoader" class="mvola-loader"></div>
                        <span id="mvolaStatusText" class="mvola-status-text">Confirmation MVola en attente...</span>
                    </div>
                    <img src="~/images/MVola.png" alt="MVola" class="w-20">
                    <span id="mvolaStatusBadge" class="mvola-badge">En cours</span>
                </div>
                <p id="mvolaStatusSubText" class="mvola-sub-text">Le paiement est en cours de vérification. Cette page se met à jour automatiquement.</p>
            </div>

            <div class="bg-white rounded-lg p-6 mb-6">
                <div class="mb-4">
                    <h3 class="font-bold mb-4">Détailsj du paiement</h3>
                </div>
                
                <div class="space-y-3">
                    <div class="flex justify-between items-center p-3  bg-yellow-400">
                        <span class="text-gray-700 font-medium">Montant:</span>
                        <span class="text-2xl font-bold text-green-700">@Model.Amount.ToString("C")</span>
                        <input type="hidden" asp-for="Amount" />
                    </div>
                    
                    <div class="flex justify-between items-center p-3 border-b border-yellow-400">
                        <span class="text-gray-700 font-medium">Plaque du véhicule:</span>
                        <span class="text-gray-900 font-semibold">@Model.CarPlate</span>
                        <input type="hidden" asp-for="CarPlate" />
                    </div>
                    
                    <div class="flex justify-between items-center p-3 border-b border-yellow-400">
                        <span class="text-gray-700 font-medium">Type:</span>
                        <span class="text-gray-900">@Model.SelectedType</span>
                        <input type="hidden" asp-for="SelectedType" />
                    </div>
                    
                    <div class="flex justify-between items-center p-3 border-b border-yellow-400">
                        <span class="text-gray-700 font-medium">Numéro client:</span>
                        <span class="text-gray-900">@Model.CustomerNumber</span>
                    </div>
                    
                    <div class="flex justify-between items-center p-3 border-b border-yellow-400">
                        <span class="text-gray-700 font-medium">Méthode:</span>
                        <span class="inline-block bg-yellow-400 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">@Model.Method</span>
                    </div>
                    
                    <div class="flex justify-between items-center pt-2">
                        <span class="text-gray-700 font-medium">Période:</span>
                        <span class="text-gray-900">@Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</span>
                        <input type="hidden" asp-for="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <input type="hidden" asp-for="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div id="actionButtons" class="button-container mvola-hidden">
                <button type="submit" class="send-button">
                    <i class="bi bi-check-circle me-2"></i>
                    Enregistrer le paiement
                </button>

                <a asp-action="Index" class="reset-button">
                    <i class="bi bi-x-circle me-2"></i>
                    Annuler
                </a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>
        let statusInterval;

        const actionButtons = document.getElementById("actionButtons");
        const statusCard = document.getElementById("mvolaStatusCard");
        const statusText = document.getElementById("mvolaStatusText");
        const statusSubText = document.getElementById("mvolaStatusSubText");
        const statusBadge = document.getElementById("mvolaStatusBadge");
        const loader = document.getElementById("mvolaLoader");

        function finalizeStatus(state) {
            actionButtons.classList.remove("mvola-hidden");

            if (state === "completed") {
                statusCard.classList.add("mvola-completed");
                statusText.textContent = "Paiement MVola confirmé";
                statusSubText.textContent = "Le paiement est validé. Vous pouvez maintenant enregistrer l'opération.";
                statusBadge.textContent = "Complété";
            }

            if (state === "failed") {
                statusCard.classList.add("mvola-failed");
                statusText.textContent = "Paiement MVola échoué";
                statusSubText.textContent = "La confirmation a échoué. Vous pouvez annuler ou tenter l'enregistrement selon votre vérification.";
                statusBadge.textContent = "Échoué";
            }

            loader.classList.add("mvola-hidden");
        }

        async function checkStatus(correlationId) {
            try {
                const response = await fetch(`/Payment/mvola/status/${correlationId}`);
                const data = await response.json();

                const statusData = typeof data.status === "string" ? JSON.parse(data.status) : data.status;
                const currentStatus = statusData?.status;

                if (currentStatus === "completed") {
                    clearInterval(statusInterval);
                    finalizeStatus("completed");
                }

                if (currentStatus === "failed") {
                    clearInterval(statusInterval);
                    finalizeStatus("failed");
                }
            } catch (error) {
                console.error("Erreur de vérification du statut MVola:", error);
            }
        }

        checkStatus(@Html.Raw(Json.Serialize(Model.CorrelationId)));
        statusInterval = setInterval(() => {
            checkStatus(@Html.Raw(Json.Serialize(Model.CorrelationId)));
        }, 4000);
    </script>
}