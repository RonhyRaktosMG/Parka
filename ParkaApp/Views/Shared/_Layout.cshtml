<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ParkaApp</title>


    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        asphalt: "#141414",
                        asphaltLight: "#41423a",
                        parking: "#ed7d27",
                        parkingDark: "#d9641e",
                        soft: "#f7f7f7"
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/ParkaApp.styles.css" asp-append-version="true" />

    
    <link rel="stylesheet"
          href="~/css/parking-theme.css"
          asp-append-version="true" />
</head>

<body class="bg-asphalt text-soft min-h-screen flex flex-col">

    <!-- BACKGROUND -->
    <div class="parking-overlay"></div>

    <!-- FLOATING NAVBAR -->
    <div class="fixed bottom-6 left-6 z-50">

        <!-- MENU -->
        <div id="floatingMenu"
             class="floating-menu hidden mb-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-house-door-fill"></i>
                <span>Home</span>
            </a>

            <a asp-controller="Area"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Areas</span>
            </a>

            <a asp-controller="Place"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-p-square-fill"></i>
                <span>Places</span>
            </a>

            <a asp-controller="Client"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-person-fill"></i>
                <span>Clients</span>
            </a>

            <a asp-controller="Occupation"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-car-front-fill"></i>
                <span>Occupations</span>
            </a>

            <a asp-controller="Payment"
               asp-action="Index"
               class="floating-link">
                <i class="bi bi-credit-card-fill"></i>
                <span>Payments</span>
            </a>
        </div>

        <!-- BUTTON -->
        <button id="menuButton"
                class="menu-button">

            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </button>
    </div>

    <!-- MAIN -->
    <main class="flex-1 relative z-10">

        <div class="max-w-7xl mx-auto px-4 py-8">
            @RenderBody()
        </div>

    </main>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/navbar.js"
            asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
